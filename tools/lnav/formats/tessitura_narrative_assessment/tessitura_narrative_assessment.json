{
  "$schema": "https://lnav.org/schemas/format-v1.schema.json",
  "tessitura_narrative_assessment": {
    "title": "Tessitura Narrative Assessment",
    "description": "Executions of the Tessitura narrative-assessment narrator.",
    "file-type": "json",
    "file-pattern": "narrative-assessments\\.jsonl$",
    "hide-extra": true,
    "timestamp-field": "completed_at",
    "timestamp-format": [
      "%Y-%m-%dT%H:%M:%S.%f%z",
      "%Y-%m-%dT%H:%M:%S%z"
    ],
    "convert-to-local-time": true,
    "ordered-by-time": true,
    "timestamp-point-of-reference": "end",
    "duration-field": "duration_milliseconds",
    "duration-divisor": 1000,
    "opid-field": "execution_id",
    "line-format": [
      {
        "field": "__timestamp__",
        "timestamp-format": "%Y-%m-%d %H:%M:%S"
      },
      "  ASSESSMENT   ",
      {
        "field": "__duration__",
        "min-width": 9,
        "align": "right"
      },
      "  ↓",
      {
        "field": "input_tokens",
        "min-width": 4,
        "align": "right"
      },
      " ↑",
      {
        "field": "output_tokens",
        "min-width": 4,
        "align": "right"
      },
      "  ",
      {
        "field": "model",
        "min-width": 20,
        "max-width": 20,
        "overflow": "last-word"
      },
      "  #",
      {
        "field": "execution_id",
        "min-width": 8,
        "max-width": 8,
        "overflow": "truncate"
      },
      "  │  ",
      {
        "field": "intention_archetype/name",
        "min-width": 12,
        "max-width": 18,
        "overflow": "dot-dot"
      },
      "  ",
      {
        "field": "trigger",
        "min-width": 22,
        "max-width": 28,
        "overflow": "last-word"
      },
      "  I ",
      {
        "field": "previous_assessment/intensity",
        "min-width": 3,
        "align": "right"
      },
      "→",
      {
        "field": "resulting_assessment/intensity",
        "min-width": 3,
        "align": "right"
      },
      "  P ",
      {
        "field": "previous_assessment/pressure",
        "min-width": 3,
        "align": "right"
      },
      "→",
      {
        "field": "resulting_assessment/pressure",
        "min-width": 3,
        "align": "right"
      }
    ],
    "value": {
      "record_schema_version": {
        "kind": "integer",
        "hidden": true
      },
      "execution_id": {
        "kind": "string",
        "identifier": true
      },
      "narrative_engine_version": {
        "kind": "string",
        "hidden": true
      },
      "completed_at": {
        "kind": "timestamp",
        "hidden": true
      },
      "duration_milliseconds": {
        "kind": "integer"
      },
      "provider": {
        "kind": "string",
        "hidden": true
      },
      "model": {
        "kind": "string",
        "identifier": true
      },
      "instructions": {
        "kind": "string",
        "hidden": true
      },
      "question_id": {
        "kind": "string",
        "identifier": true,
        "hidden": true
      },
      "intention_id": {
        "kind": "string",
        "identifier": true,
        "hidden": true
      },
      "trigger": {
        "kind": "string",
        "identifier": true
      },
      "initial_context": {
        "kind": "string",
        "hidden": true
      },
      "intention_direction": {
        "kind": "string",
        "hidden": true
      },
      "intention_archetype": {
        "kind": "json",
        "hidden": true
      },
      "intention_archetype/name": {
        "kind": "string",
        "identifier": true
      },
      "intention_archetype/description": {
        "kind": "string",
        "hidden": true
      },
      "previous_assessment": {
        "kind": "json",
        "hidden": true
      },
      "previous_assessment/intensity": {
        "kind": "integer"
      },
      "previous_assessment/pressure": {
        "kind": "integer"
      },
      "previous_assessment/justification": {
        "kind": "string",
        "hidden": true
      },
      "provider_response_id": {
        "kind": "string",
        "identifier": true,
        "hidden": true
      },
      "raw_response": {
        "kind": "json",
        "hidden": true
      },
      "resulting_assessment": {
        "kind": "json",
        "hidden": true
      },
      "resulting_assessment/intensity": {
        "kind": "integer"
      },
      "resulting_assessment/pressure": {
        "kind": "integer"
      },
      "resulting_assessment/justification": {
        "kind": "string",
        "hidden": true
      },
      "input_tokens": {
        "kind": "integer"
      },
      "output_tokens": {
        "kind": "integer"
      }
    }
  }
}
